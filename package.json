{
  "name": "profile-compressor",
  "version": "2.0.0",
  "description": "ProFile Compressor — Target-locked image compression with hybrid client/server engine. 100% client-side for files ≤80MB, optional Node backend for larger files. Features 3D geometric VFX, 19 input formats (including TIFF/HEIC), and WebP/JPEG/PNG output.",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "echo \"No tests specified\" && exit 0",
    "lint": "eslint server.js",
    "clean": "rm -rf node_modules package-lock.json",
    "reinstall": "npm run clean && npm install"
  },
  "keywords": [
    "image-compression",
    "webp",
    "jpeg",
    "png",
    "tiff",
    "heic",
    "sharp",
    "express",
    "privacy-first",
    "client-side"
  ],
  "author": "ProFile Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/profile-compressor"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.33.4"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "nodemon": "^3.1.0"
  }
}